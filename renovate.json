{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Dépendances Cargo/npm pré-1.0 : un bump mineur (0.x → 0.y) est cassant. Pas de PR automatique ; à approuver depuis le Dependency Dashboard (traitement manuel, une PR par majeur).",
      "matchManagers": [
        "cargo",
        "npm"
      ],
      "matchCurrentValue": "/^[~^=v ]*0\\./",
      "matchUpdateTypes": [
        "minor"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "grammers-client/session 0.10 : migration différée (réécriture API client/session + souci upstream glass_pumpkin). Jamais de PR automatique.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "grammers-client",
        "grammers-session"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Majeurs Cargo/npm traités manuellement (une PR par majeur) : pas de PR automatique, visibles sur le Dependency Dashboard.",
      "matchManagers": [
        "cargo",
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Regroupe les mises à jour non majeures des crates Rust dans une seule PR",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "rust non-major"
    },
    {
      "description": "Regroupe les mises à jour non majeures du backoffice dans une seule PR",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "apps/backoffice/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "backoffice non-major"
    },
    {
      "description": "Regroupe les mises à jour non majeures de la doc et de la racine dans une seule PR",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "apps/docs/**",
        "package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "docs & root non-major"
    },
    {
      "description": "Regroupe les mises à jour non majeures de la CI (GitHub Actions & images Docker)",
      "matchManagers": [
        "github-actions",
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "ci non-major"
    }
  ]
}
